import wollok.game.*
import src.messi.*
import src.barraEmocional.*
import src.recolectables.*
import src.estados.*
import src.niveles.*
import src.partida.*
import src.pantallas.*
import src.musica.*

program juego {
  game.title("Messi Game")
  game.width(16)
  game.height(9)
  game.cellSize(60)
  game.boardGround("board.png")
  reproductorMusical.iniciarMusicaFondo()

  
  pantallaMenu.mostrar()

  game.start()
}